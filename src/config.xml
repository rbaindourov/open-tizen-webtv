<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns:tizen="http://tizen.org/ns/widgets" xmlns="http://www.w3.org/ns/widgets" id="https://example.org/open-webtv" version="1.0.0" viewmodes="maximized">
    <access origin="*" subdomains="true"></access>

    <tizen:application id="OSWebTVApp.OpenWebTV" package="OSWebTVApp" required_version="2.3"/>

    <tizen:app-control>
        <tizen:src name="index.html" reload="disable"></tizen:src>
        <tizen:operation name="http://tizen.org/appcontrol/operation/view"></tizen:operation>
    </tizen:app-control>

    <tizen:service id="OSWebTVApp.service">
        <tizen:content src="service/service.js"/>
        <tizen:name>OpenWebTVPreviewService</tizen:name>
        <tizen:description>Smart Hub Preview Background Service</tizen:description>
        <tizen:category name="http://tizen.org/category/service"/>
    </tizen:service>

    <tizen:metadata key="http://samsung.com/tv/metadata/devel.api.version" value="2.4"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/use.preview" value="bg_service"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/prelaunch.support" value="true"/>

    <author href="https://example.org" email="dev@example.org">Open WebTV Contributors</author>

    <content src="index.html"/>

    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <feature name="http://tizen.org/feature/tv.audio"/>
    <feature name="http://tizen.org/feature/tv.display"/>

    <icon src="logo.png"/>
    <name>Open WebTV</name>

    <tizen:privilege name="http://developer.samsung.com/privilege/widgetdata"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.display"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/application.info"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>

    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
